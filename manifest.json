{
  "manifest_version": 3,
  "name": "哔哩哔哩推送",
  "version": "1.0.0",
  "description": "当关注的UP开播或更新视频/动态时发出Windows通知提醒",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "background"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://api.live.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开哔哩哔哩推送设置",
    "default_icon": "assets/icon.png"
  },
  "options_page": "src/options/settings.html",
  "icons": {
    "128": "assets/icon.png"
  }
}
